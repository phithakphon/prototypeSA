# Reference file (not loaded by Vite). Copy these to your hosting dashboard (Vercel / Netlify > Environment Variables). Do NOT commit real values.
# Vite bakes VITE_* values into the public JavaScript bundle: never put a secret here.

# Backend ORIGIN only: https, no trailing slash, no "/api". Example: https://ems-api.onrender.com
# Leave empty only if your hosting rewrites /api/* to the backend (same-origin).
VITE_API_URL=https://YOUR-BACKEND.onrender.com

# Production builds can never use mock data; setting VITE_USE_MOCK=true makes the build fail on purpose.
