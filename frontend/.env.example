# Copy to frontend/.env.local (git-ignored) for real-backend development, then RESTART `npm run dev`.
# Without VITE_USE_MOCK=false the dev server uses in-memory mock data (demo login panel, password shown on the login page).
# Unit tests (`npm test`) always force mock mode, so this file never affects them.
VITE_USE_MOCK=false
# Backend origin only (do not append /api).
# Empty uses Vite's localhost:3001 proxy; recommended for local and Codespaces development.
VITE_API_URL=
# Direct local alternative: VITE_API_URL=http://localhost:3001
# Codespaces direct: https://YOUR-CODESPACE-3001.app.github.dev
