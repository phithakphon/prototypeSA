PORT=3001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Supabase Dashboard > Connect > connection string (Session pooler recommended).
# URL-encode special characters in the password (e.g. @ -> %40). Never commit the real value.
DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-DB-PASSWORD>@<region>.pooler.supabase.com:5432/postgres
# disable (local only) | require (encrypted, certificate not verified) | verify (verified; set DB_SSL_CA for Supabase)
# Default: disable for localhost, require for any other host
DB_SSL=require
# Path to the CA certificate downloaded from Supabase (Database Settings > SSL Configuration), used when DB_SSL=verify
DB_SSL_CA=
DB_POOL_MAX=10
# true = run pending migrations when the server starts (default false: use `npm run migrate`)
AUTO_MIGRATE=false

# Only for `npm run migrate:data` (SQLite -> PostgreSQL). Original SQLite file, opened read-only.
SQLITE_PATH=./data/app.db
