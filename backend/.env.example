# Local development: copy to backend/.env (never commit .env).
# Production (Render / Railway): set these in the hosting dashboard instead, see docs/DEPLOYMENT.md.

# production | development. In production the server refuses to start with weak or unsafe settings.
NODE_ENV=development
PORT=3001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production requires at least 32 characters.
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Supabase Dashboard > Connect > connection string (Session pooler recommended).
# URL-encode special characters in the password (e.g. @ -> %40). Never commit the real value.
DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-DB-PASSWORD>@<region>.pooler.supabase.com:5432/postgres
# disable (local only) | require (encrypted, certificate not verified) | verify (verified; needs the Supabase Root CA)
# Default: disable for localhost, require for any other host. NODE_ENV=production requires verify.
DB_SSL=require
# The Supabase Root CA from Dashboard > Database Settings > SSL Configuration. Use ONE of:
#   DB_SSL_CA      path to the .crt file (local development, e.g. ./certs/prod-ca-2021.crt)
#   DB_SSL_CA_PEM  the certificate text (hosting platforms; write line breaks as \n or paste multi-line)
DB_SSL_CA=
DB_SSL_CA_PEM=
DB_POOL_MAX=10
# true = run pending migrations when the server starts (default false: use `npm run migrate`)
AUTO_MIGRATE=false

# Browsers allowed to call this API from another origin, comma separated, exact origins (https://host[:port]).
# No wildcard, no path, no trailing slash. Empty = same-origin only. Example: https://your-app.vercel.app
CORS_ORIGINS=
# Number of reverse proxies in front of the app: 1 on Render / Railway, 0 (default) when it is exposed directly.
# Needed so the login rate limit sees real client IPs.
TRUST_PROXY=0

# Only for `npm run migrate:data` (SQLite -> PostgreSQL). Original SQLite file, opened read-only.
SQLITE_PATH=./data/app.db
