{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "migrate": "node --env-file=.env src/migrate.js",
    "migrate:data": "node --env-file=.env src/migrate-data.js",
    "seed": "node --env-file=.env src/seed.js",
    "seed:dry-run": "node --env-file=.env src/seed.js --dry-run",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  }
}
